# Dependencies
node_modules/

# Build & packaging outputs
dist/
dist-electron/
out/
release/

# Large binaries (yt-dlp, ffmpeg should not be committed to Git)
resources/bin/*.exe
resources/bin/*.dll
resources/bin/*.zip
resources/bin/*.7z
!resources/bin/README.md
!resources/bin/.gitkeep

# Databases & local persistent storage
*.db
*.db-journal
*.sqlite
*.sqlite3

# Environment & local configuration
.env
.env.*
*.local

# IDE & Editor caches
.vscode/
.idea/
*.suo
*.ntvs*
*.njsproj
*.sln
*.sw?

# OS generated files
.DS_Store
Thumbs.db
ehthumbs.db

# Logs & temporary files
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*
*.tmp
